# Build wifi-connect from the vendored source (was: download a prebuilt release
# binary + UI tarball from GitHub, which ignored this repo's src/ and ui/ — so
# local customizations never shipped). Multi-stage: build the React UI, compile
# the Rust binary, assemble a slim runtime. Toolchains are pinned (Rust 1.76 per
# upstream flowzone CI; Node 18) and Cargo builds --locked for reproducibility.
# Native build on the balena builder for the fleet architecture.

# --- UI build --------------------------------------------------------------
FROM node:18-bullseye AS ui
WORKDIR /ui
COPY ui/package.json ui/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY ui/ ./
# Ensure the captive-portal UI rebuilds when branding/copy changes (balena
# layer cache otherwise keeps a stale React bundle across submodule bumps).
ARG UI_BUILD_ID=truelook-portal-2026-07-15
RUN echo "ui build id: ${UI_BUILD_ID}" && npm run build

# --- Rust build ------------------------------------------------------------
FROM rust:1.76-bullseye AS build
RUN apt-get update && apt-get install -y --no-install-recommends \
    libdbus-1-dev pkg-config && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY src/ ./src/
RUN cargo build --release --locked

# --- Runtime ---------------------------------------------------------------
FROM debian:bullseye-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl dnsmasq iproute2 libdbus-1-3 wireless-tools \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /usr/src/app
COPY --from=build /src/target/release/wifi-connect ./wifi-connect
# The binary serves the UI from ./ui relative to its working directory.
COPY --from=ui /ui/build ./ui
COPY scripts/start.sh .

CMD ["bash", "start.sh"]
