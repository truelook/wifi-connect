# Build wifi-connect from the vendored source. The captive-portal UI is a single
# self-contained static HTML page (no framework, no external fonts/CDNs) so it
# loads instantly and reliably inside phone captive-network browsers — a large
# React bundle would sit on a blank/"Loading" screen and the CNA sheet would
# time out and reload. We only compile the Rust binary here.
# Toolchain pinned (Rust 1.76 per upstream flowzone CI); Cargo builds --locked.

# --- Rust build ------------------------------------------------------------
FROM rust:1.76-bullseye AS build
RUN apt-get update && apt-get install -y --no-install-recommends \
    libdbus-1-dev pkg-config && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY src/ ./src/
RUN cargo build --release --locked

# --- Runtime ---------------------------------------------------------------
FROM debian:bullseye-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl dnsmasq iproute2 libdbus-1-3 wireless-tools \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /usr/src/app
COPY --from=build /src/target/release/wifi-connect ./wifi-connect
# The binary serves the UI from ./ui relative to its working directory. Ship the
# static portal page directly — no Node build step.
COPY ui-static/ ./ui/
COPY scripts/start.sh .

CMD ["bash", "start.sh"]
